<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Guards the run-time USB permission result receivers on Android 12 and older. -->
    <permission
        android:name="${applicationId}.USB_PERMISSION_RESULT"
        android:protectionLevel="signature" />
    <uses-permission android:name="${applicationId}.USB_PERMISSION_RESULT" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- The cable's fallback notification. A no-op before Android 13; on 13+ the driver may have to
         allow notifications once, and the activity is still reachable from the launcher. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Self-scan only: proves our own 0xFDEE advertisement is on the air. neverForLocation keeps the
         prompt in the same "nearby devices" group as connect/advertise. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <!-- HiCar publishes its 0xFDEE discovery advertisement over BLE; BluetoothLeAdvertiser needs this. -->
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <!-- Optional: a BLE advertisement is only published on head units that support peripheral mode. -->
    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="false" />
    <!-- No maxSdkVersion: MIUI 13 on Android 12 still checks BLUETOOTH for RFCOMM connections (#671). -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />

    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false" />

    <queries>
        <package android:name="com.byd.carsettings" />
        <package android:name="com.byd.appmgr" />
        <package android:name="com.byd.deviceinfo" />
        <package android:name="com.byd.service" />
        <intent>
            <action android:name="android.settings.WIFI_SETTINGS" />
        </intent>
        <package android:name="com.byd.clusterdebug" />
        <package android:name="com.ts.car.someip.service" />
        <package android:name="com.byd.amapservice" />
        <package android:name="com.byd.automap" />
        <intent>
            <action android:name="com.android.settings.WIFI_TETHER_SETTINGS" />
        </intent>
    </queries>

    <application android:usesCleartextTraffic="true">
        <!-- The TUN a wired session needs. Only the car's own subnet is routed into it; the service
             is not exported and is started by the receiver, never by anything else. -->
        <service
            android:name="com.shilapi.xcertplay.hicar.HiCarWiredVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>
    </application>
</manifest>
