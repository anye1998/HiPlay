<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
    One theme, because there is one screen. The system bars start hidden in the receiver's default
    mode; HiCarHostActivity applies whatever the display setting says on top of this, so the values
    here only matter for the first frame.
    -->
    <style name="Theme.Xcertplay" parent="android:Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#A6C8FF</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#0C111B</item>
        <item name="android:statusBarColor">#0C111B</item>
        <item name="android:windowBackground">@color/window_background_dark</item>
        <!-- Without it, API 31+ draws a white splash before the dark receiver screen. -->
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">#0C111B</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
