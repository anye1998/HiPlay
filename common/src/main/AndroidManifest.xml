<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The optional HiCar microphone uplink: recording starts only when the driver turns it on. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Optional: diagnostic reports in the visible Downloads folder on Android 9.
         Android 10+ needs no permission for this, so it is never requested there. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

    <application>
        <!-- Reports exported from the settings page: a report is shared as a content:// URI, and the
             authority stays separate so a merged manifest cannot widen the exposed paths. -->
        <provider
            android:name="com.shilapi.xcertplay.DiagnosticReportProvider"
            android:authorities="${applicationId}.diagnostic-reports"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/diagnostic_report_paths" />
        </provider>

        <!-- The whole app: setup page, session page and settings page in one activity. A settings
             activity of its own would pause this one, and a paused surface is where the mirrored
             picture goes black. -->
        <activity
            android:name="com.shilapi.xcertplay.HiCarHostActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="density|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:resizeableActivity="true"
            android:screenOrientation="fullSensor"
            android:theme="@style/Theme.Xcertplay">
            <intent-filter>
                <action android:name="com.shihab.diplay.action.HICAR_HOST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Optional: presses "允许" on the system's USB permission dialog, which is the one step of
             a wired connection that has no API. Disabled until the driver turns it on in
             Settings › Accessibility; see HiCarUsbAccessibilityService for what it will and will
             not touch. -->
        <service
            android:name="com.shilapi.xcertplay.HiCarUsbAccessibilityService"
            android:exported="false"
            android:label="@string/usb_accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/usb_accessibility" />
        </service>

        <!-- The launcher entry. The label is a literal to match the screen's own copy, which is
             Simplified Chinese on purpose and hardcoded so it reads the same on any ROM locale. -->
        <activity-alias
            android:name="com.shilapi.xcertplay.HiCarLauncherAlias"
            android:targetActivity="com.shilapi.xcertplay.HiCarHostActivity"
            android:exported="true"
            android:label="HiCar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- The second launcher entry: opens the same activity with the settings page already up.
             Not a separate activity, because a second activity would pause the receiver and a paused
             surface is where the mirrored picture goes black. The activity recognises this alias in
             its intent's component and sets `settingsOpen`. -->
        <activity-alias
            android:name="com.shilapi.xcertplay.HiCarSettingsAlias"
            android:targetActivity="com.shilapi.xcertplay.HiCarHostActivity"
            android:exported="true"
            android:icon="@drawable/ic_hicar_settings"
            android:label="HiCar 设置">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>

</manifest>
