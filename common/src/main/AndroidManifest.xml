<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The optional HiCar microphone uplink: recording starts only when the driver turns it on. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Optional: diagnostic reports in the visible Downloads folder on Android 9.
         Android 10+ needs no permission for this, so it is never requested there. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <!-- The fallback when a cable may not bring the screen up from the background: a notification
         with a full-screen intent still gets the driver into the receiver with one tap. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <application>
        <!-- Reports exported from the settings page: a report is shared as a content:// URI, and the
             authority stays separate so a merged manifest cannot widen the exposed paths. -->
        <provider
            android:name="com.shilapi.xcertplay.DiagnosticReportProvider"
            android:authorities="${applicationId}.diagnostic-reports"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/diagnostic_report_paths" />
        </provider>

        <!-- The whole app: setup page, session page and settings page in one activity. A settings
             activity of its own would pause this one, and a paused surface is where the mirrored
             picture goes black. -->
        <activity
            android:name="com.shilapi.xcertplay.HiCarHostActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="density|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:resizeableActivity="true"
            android:screenOrientation="fullSensor"
            android:theme="@style/Theme.Xcertplay">
            <intent-filter>
                <action android:name="com.shihab.diplay.action.HICAR_HOST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Optional: presses "允许" on the system's USB permission dialog, which is the one step of
             a wired connection that has no API. Disabled until the driver turns it on in
             Settings › Accessibility; see HiCarUsbAccessibilityService for what it will and will
             not touch. -->
        <service
            android:name="com.shilapi.xcertplay.HiCarUsbAccessibilityService"
            android:exported="false"
            android:label="@string/usb_accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/usb_accessibility" />
        </service>

        <!-- The only entry the driver does not press: a cable going in. Declared with a device
             filter so the process is cold-started for Huawei phones only. It starts the activity,
             and posts a full-screen notification first because Android 10 may refuse a background
             activity launch without telling anyone. -->
        <receiver
            android:name="com.shilapi.xcertplay.HiCarUsbAttachReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/usb_device_filter" />
        </receiver>

        <!-- The same device filter on an *activity alias*, which is what makes the system grant the
             cable's permission without a dialog. The system records a USB grant per device instance,
             and the phone re-enumerates as a new one when it switches to NCM — so a receiver alone
             always costs two prompts per insertion. With this alias the system offers 「默认使用」;
             tick it once and the grant arrives with the attach, before the receiver runs. The
             component is enabled by HiCarWiredAttach with the wired switch. -->
        <activity-alias
            android:name="com.shilapi.xcertplay.HiCarUsbAttachAlias"
            android:enabled="true"
            android:exported="true"
            android:targetActivity="com.shilapi.xcertplay.HiCarHostActivity">
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/usb_device_filter" />
        </activity-alias>

        <!-- The launcher entry. The label is a literal to match the screen's own copy, which is
             Simplified Chinese on purpose and hardcoded so it reads the same on any ROM locale. -->
        <activity-alias
            android:name="com.shilapi.xcertplay.HiCarLauncherAlias"
            android:targetActivity="com.shilapi.xcertplay.HiCarHostActivity"
            android:exported="true"
            android:label="HiCar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- The second launcher entry: opens the receiver with the settings page already up.
             A real activity, not an `activity-alias`: the alias resolved fine but the head unit's
             launcher listed only the first entry, because both aliases target the same activity and
             that launcher keys its icon list by package. This one is a doorway — NoDisplay, launches
             the host and finishes in the first frame — so the receiver is never left behind a paused
             surface. See HiCarSettingsLaunchActivity. -->
        <activity
            android:name="com.shilapi.xcertplay.HiCarSettingsLaunchActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:icon="@drawable/ic_hicar_settings"
            android:label="HiCar 设置"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
